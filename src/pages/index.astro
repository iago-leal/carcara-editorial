---
import Base from '../layouts/Base.astro';
import CartaoMateria from '../components/CartaoMateria.astro';
import { organizacao } from '../lib/marca';
import { materiasPublicadas } from '../lib/materias';
import { SITE } from '../lib/site';

const [manchete, ...recentes] = await materiasPublicadas();
const editora = await organizacao(Astro.site!);
const dadosEstruturados = [
  {
    '@type': 'WebSite',
    '@id': new URL('/#site', Astro.site).href,
    name: SITE.nome,
    description: SITE.descricao,
    url: new URL('/', Astro.site).href,
    inLanguage: SITE.idioma,
    publisher: { '@id': editora['@id'] },
  },
  editora,
];
---

<Base descricao={SITE.descricao} dadosEstruturados={dadosEstruturados}>
  <div class="container">
    <h1 class="visualmente-oculto">Carcará Editorial</h1>

    {
      manchete ? (
        <>
          <CartaoMateria materia={manchete} destaque />
          {recentes.length > 0 && (
            <section aria-labelledby="titulo-recentes">
              <h2 id="titulo-recentes" class="secao-titulo">Mais recentes</h2>
              <div class="grade">
                {recentes.map((materia) => (
                  <CartaoMateria materia={materia} />
                ))}
              </div>
            </section>
          )}
        </>
      ) : (
        <section class="aviso leitura" aria-labelledby="titulo-aviso">
          <p class="rotulo">Em breve</p>
          <h2 id="titulo-aviso">As primeiras matérias estão a caminho</h2>
          <p>
            O Carcará Editorial explica política, economia e tecnologia com dados públicos de fontes
            oficiais, como o IBGE, o Banco Central, o Tesouro Nacional e o Tribunal Superior Eleitoral.
            Enquanto as matérias não chegam, os vídeos estão no <a href="https://www.youtube.com/@carcara.editorial" rel="noopener">YouTube</a> e no <a href="https://www.instagram.com/carcara.editorial/" rel="noopener">Instagram</a>.
          </p>
        </section>
      )
    }
  </div>
</Base>

<style>
  .aviso {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding-block: var(--base-size-24) var(--base-size-40);
    border-top: var(--borderWidth-thicker) solid var(--borderColor-accent-emphasis);
  }

  .aviso h2 {
    font-size: clamp(var(--base-text-size-lg), 4vw, var(--base-text-size-xl));
  }

  .aviso p {
    margin: 0;
  }

  .aviso p:last-child {
    font-size: var(--carcara-texto-leitura);
    line-height: var(--base-text-lineHeight-relaxed);
    color: var(--fgColor-muted);
  }
</style>
