---
import '@fontsource-variable/inter';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/tokens.css';
import '../styles/carcara.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import logo from '../assets/marca/carcara.png';
import Cabecalho from '../components/Cabecalho.astro';
import Rodape from '../components/Rodape.astro';

interface Props {
  titulo?: string;
  descricao: string;
  tipo?: 'website' | 'article';
}

const NOME = 'Carcará Editorial';
const { titulo, descricao, tipo = 'website' } = Astro.props;
const tituloDaAba = titulo ? `${titulo} · ${NOME}` : NOME;
const canonica = new URL(Astro.url.pathname, Astro.site);

// Os ícones do navegador e da tela inicial do celular saem da mesma logo, no build.
const icone = await getImage({ src: logo, width: 32, height: 32, format: 'png' });
const iconeApple = await getImage({ src: logo, width: 180, height: 180, format: 'png' });
const imagemCompartilhamento = await getImage({ src: logo, width: 512, height: 512, format: 'png' });
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{tituloDaAba}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonica} />
    <link rel="icon" href={icone.src} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={iconeApple.src} />
    <link rel="alternate" type="application/rss+xml" title={NOME} href="/rss.xml" />
    <meta property="og:site_name" content={NOME} />
    <meta property="og:type" content={tipo} />
    <meta property="og:title" content={titulo ?? NOME} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonica} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:image" content={new URL(imagemCompartilhamento.src, Astro.site)} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:image:alt" content="Logo do Carcará Editorial: cabeça de carcará em laranja, branco e preto" />
    <slot name="head" />
  </head>
  <body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    <Cabecalho />
    <main id="conteudo">
      <slot />
    </main>
    <Rodape />
  </body>
</html>
